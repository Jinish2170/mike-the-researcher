{
  "name": "mike-the-researcher",
  "version": "0.1.0",
  "description": "AI research assistant — searches the web, reads sources, returns a cited brief",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "api": "ts-node src/api/server.ts",
    "frontend": "npm run build --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "start": "npm run api",
    "start:all": "concurrently \"npm run api\" \"npm run frontend:dev\"",
    "typecheck": "tsc --noEmit",
    "test": "ts-node src/extract/__tests__/tools.test.ts && ts-node src/extract/__tests__/parsers.test.ts",
    "test:live": "ts-node src/extract/__tests__/github-live.test.ts && ts-node src/extract/__tests__/extractors.test.ts",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "research",
    "ai",
    "agent",
    "web-search",
    "rag",
    "synthesis",
    "perplexity-clone"
  ],
  "license": "MIT",
  "author": "Jinish Dhola",
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "jsdom": "^25.0.0",
    "openai": "^4.70.0",
    "p-queue": "^8.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
