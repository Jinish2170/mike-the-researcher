# LLM provider — defaults to NVIDIA NIM (OpenAI-compatible).
# Get a free API key at https://build.nvidia.com/
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
LLM_MODEL=meta/llama-3.3-70b-instruct

# Optional: Tavily Search API for higher-quality web search (free tier available).
# Leave unset to use the free DuckDuckGo backend.
# TAVILY_API_KEY=tvly-your-key-here

# Server
PORT=3002

# Tuning (optional)
# REQUEST_TIMEOUT_MS=15000
# FETCH_CONCURRENCY=4
# MAX_CONTENT_CHARS=8000
